{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Conn": "Server=(localdb)\\MSSQLLocalDB;Database=EmailToAll;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": "587",
    "SenderName": "EmailToAll",
    "SenderEmail": "your-email@example.com",
    "Password": "REPLACE_ME"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_ME_with_a_random_secret_of_at_least_32_characters",
    "Issuer": "EmailToAll",
    "Audience": "EmailToAllUsers",
    "ExpiryMinutes": 120
  },
  "Encryption": {
    "Key": "REPLACE_ME_exactly_32_characters",
    "IV": "REPLACE_ME_16chr"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "SmtpProviders": [
    {
      "Name": "Gmail",
      "Domains": [ "gmail.com", "googlemail.com" ],
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseStartTls": true
    },
    {
      "Name": "Outlook",
      "Domains": [ "outlook.com", "hotmail.com", "live.com", "msn.com" ],
      "Host": "smtp-mail.outlook.com",
      "Port": 587,
      "UseStartTls": true
    },
    {
      "Name": "Yahoo",
      "Domains": [ "yahoo.com", "ymail.com" ],
      "Host": "smtp.mail.yahoo.com",
      "Port": 587,
      "UseStartTls": true
    },
    {
      "Name": "iCloud",
      "Domains": [ "icloud.com", "me.com" ],
      "Host": "smtp.mail.me.com",
      "Port": 587,
      "UseStartTls": true
    },
    {
      "Name": "Zoho",
      "Domains": [ "zoho.com" ],
      "Host": "smtp.zoho.com",
      "Port": 587,
      "UseStartTls": true
    }
  ]
}
