# Where the Vite dev server forwards /api requests (the ASP.NET Core API).
# The default matches the "http" profile in src/EmailToAll/Properties/launchSettings.json.
VITE_API_PROXY=http://localhost:5018

# Only needed when the built frontend is served from a different origin than the API.
# Leave empty to call the API on the same origin.
# VITE_API_URL=https://api.example.com
